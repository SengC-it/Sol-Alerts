{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sol-alerts/strategy-config.schema.json",
  "title": "Sol Alerts Strategy Configuration",
  "type": "object",
  "required": ["configVersion", "schemaVersion", "publishedAt", "universe", "marketState", "strategies", "execution", "weights", "score", "risk", "research"],
  "properties": {
    "configVersion": { "type": "string", "pattern": "^1\\.0\\.[0-9]+$" },
    "schemaVersion": { "const": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "universe": { "type": "object", "required": ["quoteAsset", "contractType", "minFormalHistoryDays", "shadowStartDays", "minQuoteVolume24h", "maxSpreadBps", "minDepthNotionalUsdt", "depthBandPct", "referenceMaxOrderNotionalUsdt"], "properties": { "minQuoteVolume24h": { "const": 20000000 } } },
    "marketState": { "type": "object", "required": ["emaFast", "emaSlow", "adxPeriod", "atrPeriod", "trendThresholds", "rangeThresholds"] },
    "strategies": { "type": "object", "required": ["trend_breakout", "trend_pullback", "range_mean_reversion"] },
    "execution": { "type": "object", "required": ["takerFeeRatePerSide", "baseAdverseSlippageRatePerSide", "entryValidityMinutes", "maxHoldHours", "minimumNetRewardRisk", "riskPerSimulatedTrade", "maxOpenPositions", "maxLongPositions", "maxShortPositions", "maxSignalsPerEmail"] },
    "weights": { "type": "object", "required": ["globalBase", "symbolDeviationCap", "shrinkagePrior", "shadowBelow", "recoveryAbove", "weeklyChangeCap"] },
    "score": { "type": "object", "required": ["highPriorityMinimum", "ordinaryMinimum", "historicalRobustnessMax", "currentSetupMax", "marketStateMatchMax", "executionQualityMax"] },
    "risk": { "type": "object", "required": ["correlationLookbackDays", "correlationThreshold", "maxClusterSignalsPerDirection", "extremeReturnPercentile", "extremePauseMinutes", "emergencyDrawdownMultiple", "statisticalRollbackMinimumClosedSignals", "statisticalRollbackAlpha"] },
    "research": { "type": "object", "required": ["trainFraction", "validationFraction", "testFraction", "adaptiveLongWindowMonths", "adaptiveRecentWindowDays", "minimumTestTradesPerSymbolStrategy", "minimumTestTradesPerFamily", "bootstrapReplicates", "randomSeed", "maxPortfolioDrawdown"] }
  },
  "additionalProperties": false
}
