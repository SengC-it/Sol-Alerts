# Server-only runtime configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
CRON_SECRET=<long-random-value>
GMAIL_SMTP_USER=alerts@example.com
GMAIL_SMTP_APP_PASSWORD=<gmail-app-password>
ALERT_RECIPIENT=recipient@example.com
CONFIG_PATH=config/strategy-v1.json
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
MIN_SCAN_DATA_AGE_SECONDS=120
OUTBOX_BATCH_SIZE=10
NODE_ENV=production
